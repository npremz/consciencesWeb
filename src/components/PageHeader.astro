---
interface Props {
  title: string;
  subtitle: string;
  image: string;
}

const { title, subtitle, image } = Astro.props as Props;
---

<div class="relative w-full h-[50vh] min-h-[400px] flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0">
    <img src={image} alt={title} class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/40 backdrop-blur-[2px]"></div>
  </div>

  <div class="relative z-10 text-center text-white max-w-4xl px-4 animate-fade-in-up">
    <h1 class="text-4xl md:text-6xl font-serif mb-4">{title}</h1>
    <div class="w-24 h-1 bg-emerald-500 mx-auto mb-6"></div>
    <p class="text-lg md:text-xl font-light text-white/90">{subtitle}</p>
  </div>
</div>
