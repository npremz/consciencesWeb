---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import { Calendar, MapPin, Clock, ArrowRight } from 'lucide-react';

import { getImage } from "astro:assets";
import headerImage from "../assets/hero-bg.png";

const optimizedHeader = await getImage({ src: headerImage, format: 'webp', width: 1920 });
---

<Layout title="Agenda & Événements | Anne Marie Van Der Smissen - Consciences">
  <Navbar client:load />
  
  <PageHeader 
    title="Agenda" 
    subtitle="Prochains ateliers, conférences et journées découvertes."
    image={optimizedHeader.src}
  />

  <section class="py-20 3xl:py-40 max-w-[1000px] mx-auto px-6">
    
    {/* Upcoming Event Card */}
    <div class="mb-12">
      <h2 class="text-2xl font-serif text-emerald-900 mb-8 border-b border-neutral-200 pb-4">Prochainement</h2>
      
      <div class="bg-white rounded-2xl shadow-lg border border-neutral-100 overflow-hidden flex flex-col md:flex-row group hover:shadow-xl transition-shadow">
        <div class="md:w-1/3 bg-emerald-900 p-6 md:p-8 flex flex-col justify-center text-white text-center">
            <span class="text-5xl font-serif mb-2">21</span>
            <span class="text-xl uppercase tracking-widest opacity-80">Septembre</span>
            <span class="mt-4 opacity-60">2026</span>
        </div>
        <div class="p-6 md:p-8 md:w-2/3 flex flex-col justify-center">
            <h3 class="text-2xl font-serif text-emerald-950 mb-4">Gestion du Stress Professionnel</h3>
            <div class="flex flex-col gap-2 text-neutral-600 mb-6 text-sm">
                <div class="flex items-center gap-2">
                    <Clock size={16} className="shrink-0" /> 13h30 - 16h30
                </div>
                <div class="flex items-center gap-2">
                    <MapPin size={16} className="shrink-0" /> Centre Albiome, Lesve
                </div>
            </div>
            <p class="text-neutral-600 mb-6 line-clamp-2">
                Identifier les sources de stress et apprendre des techniques concrètes de sophrologie pour le gérer au quotidien.
            </p>
            <div class="flex items-center justify-between mt-auto">
                <span class="font-bold text-emerald-700 text-lg">60€</span>
                <a href="/contact/" class="px-6 py-2 bg-emerald-600 text-white rounded-xl hover:bg-emerald-700 transition-colors font-medium shadow-lg shadow-emerald-900/10">
                    S'inscrire
                </a>
            </div>
        </div>
      </div>
    </div>

    {/* Past Events */}
    <div>
        <h2 class="text-2xl font-serif text-neutral-400 mb-8 border-b border-neutral-200 pb-4">Événements Passés</h2>
        
        <div class="space-y-6 opacity-60 hover:opacity-100 transition-opacity">
            
            {/* Event Item */}
            <div class="flex flex-col md:flex-row gap-6 border-b border-neutral-100 pb-6">
                <div class="md:w-32 font-bold text-neutral-400">12 Mai</div>
                <div class="flex-1">
                    <h3 class="font-bold text-lg mb-2">L'Amour de Soi</h3>
                    <p class="text-sm text-neutral-500">Atelier gratuit d'inauguration au Centre Albiome.</p>
                </div>
                <div class="text-sm px-3 py-1 bg-neutral-100 rounded-lg self-start">Complet</div>
            </div>

            {/* Event Item */}
            <div class="flex flex-col md:flex-row gap-6 border-b border-neutral-100 pb-6">
                <div class="md:w-32 font-bold text-neutral-400">9 Mars</div>
                <div class="flex-1">
                    <h3 class="font-bold text-lg mb-2">Découverte Sophrologie & Pensée Positive</h3>
                    <p class="text-sm text-neutral-500">Maison de l'Écologie, Namur.</p>
                </div>
                <div class="text-sm px-3 py-1 bg-neutral-100 rounded-lg self-start">Terminé</div>
            </div>

        </div>
    </div>

  </section>

  <Footer />
</Layout>
