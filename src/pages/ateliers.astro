---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import PageHeader from '../components/PageHeader';
import Footer from '../components/Footer';
import { Coffee, Sun, Utensils, Moon, CheckCircle, Sparkles, Users } from 'lucide-react';

import { getImage } from "astro:assets";
import headerImage from "../assets/hero-bg.png";

const optimizedHeader = await getImage({ src: headerImage, format: 'webp', width: 1920 });
---

<Layout title="Ateliers & Journées Meilleur-Être | Anne-Marie van der Smissen - Consciences">
  <Navbar client:load />
  
  <PageHeader 
    title="Journées Mieux-Être" 
    subtitle="Une parenthèse pour vous ressourcer et explorer de nouvelles pratiques."
    image={optimizedHeader.src}
    client:load
  />

  <section class="py-20 3xl:py-40 max-w-[1000px] mx-auto px-6">
    
    <div class="mb-16 text-center max-w-2xl mx-auto">
      <p class="text-lg text-neutral-600 leading-relaxed">
        Je vous propose une sélection de 4-5 ateliers variés selon la saison et l'humeur. 
        Sophrologie, PNL, Yoga Nidra, auto-hypnose, balade méditative, écriture créative...
      </p>
    </div>

    {/* Timeline Programme */}
    <div class="relative border-l-2 border-emerald-100 mx-auto max-w-xl space-y-12 mb-20 px-4 sm:px-0">
      
      {/* Item */}
      <div class="relative pl-8 sm:pl-10">
        <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-emerald-500 border-4 border-white shadow-sm"></div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6">
          <span class="font-bold text-emerald-800 text-lg sm:w-32 shrink-0">09:00</span>
          <div class="flex items-center gap-3 text-neutral-800 font-medium">
            <Coffee size={20} className="text-emerald-600 shrink-0" />
            Accueil & Boisson de bienvenue
          </div>
        </div>
      </div>

       {/* Item */}
       <div class="relative pl-8 sm:pl-10">
        <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-emerald-500 border-4 border-white shadow-sm"></div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6">
          <span class="font-bold text-emerald-800 text-lg sm:w-32 shrink-0">09:30 - 12:15</span>
          <div class="flex items-center gap-3 text-neutral-700 font-medium">
            <Sun size={20} className="text-emerald-600 shrink-0" />
            Ateliers du Matin (x2)
          </div>
        </div>
        <p class="text-sm text-neutral-500 mt-2 sm:ml-40">Initiation pratique, exercices dynamiques.</p>
      </div>

       {/* Item */}
       <div class="relative pl-8 sm:pl-10">
        <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-emerald-500 border-4 border-white shadow-sm"></div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6">
          <span class="font-bold text-emerald-800 text-lg sm:w-32 shrink-0">12:15 - 13:15</span>
          <div class="flex items-center gap-3 text-neutral-700 font-medium">
            <Utensils size={20} className="text-emerald-600 shrink-0" />
            Repas Convivial
          </div>
        </div>
        <p class="text-sm text-neutral-500 mt-2 sm:ml-40">Partage ou moment de calme pour intégrer.</p>
      </div>

       {/* Item */}
       <div class="relative pl-8 sm:pl-10">
        <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-emerald-500 border-4 border-white shadow-sm"></div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6">
          <span class="font-bold text-emerald-800 text-lg sm:w-32 shrink-0">13:15 - 16:00</span>
          <div class="flex items-center gap-3 text-neutral-700 font-medium">
            <Moon size={20} className="text-emerald-600 shrink-0" />
            Ateliers de l'Après-midi (x2)
          </div>
        </div>
      </div>

       {/* Item */}
       <div class="relative pl-8 sm:pl-10">
        <div class="absolute -left-[9px] top-1.5 w-4 h-4 rounded-full bg-emerald-500 border-4 border-white shadow-sm"></div>
        <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6">
          <span class="font-bold text-emerald-800 text-lg sm:w-32 shrink-0">16:30</span>
          <div class="flex items-center gap-3 text-neutral-700 font-medium">
            Clôture & Échanges
          </div>
        </div>
      </div>

    </div>

    {/* Tarifs et Options */}
    <div class="space-y-12">
      <h2 class="text-3xl font-serif text-emerald-900 mb-12 text-center">Tarifs & Formules</h2>
      
      <div class="grid md:grid-cols-2 gap-8">
        {/* Journée Classique */}
        <div class="bg-emerald-900 text-white rounded-2xl p-6 md:p-10 text-center flex flex-col justify-between">
          <div>
            <h3 class="text-2xl font-serif mb-6">Journée Classique</h3>
            <div class="text-4xl md:text-5xl font-serif mb-2">85 - 100€</div>
            <p class="text-emerald-200 mb-8 text-sm">Par personne, selon les ateliers sélectionnés</p>
            
            <ul class="text-sm space-y-3 text-emerald-100/80 mb-8 inline-block text-left">
              <li class="flex items-center gap-2"><CheckCircle size={16} className="text-emerald-400 shrink-0"/> Syllabus complet inclus</li>
              <li class="flex items-center gap-2"><CheckCircle size={16} className="text-emerald-400 shrink-0"/> Boissons & encas offerts</li>
            </ul>
          </div>
          
          <div class="space-y-6">
            <div class="inline-block bg-white/10 backdrop-blur-sm px-6 py-3 rounded-lg border border-white/20 w-full">
              <p class="font-medium flex items-center gap-2 justify-center text-sm">
                <Sparkles size={16} className="shrink-0" />
                Groupe restreint
              </p>
            </div>
            <a href="/contact" class="block w-full bg-emerald-600 hover:bg-emerald-500 text-white px-6 py-3 rounded-xl font-bold transition-colors">
              Réserver ma place
            </a>
          </div>
        </div>

        {/* Journées Spéciales */}
        <div class="bg-emerald-800 text-white rounded-2xl p-6 md:p-10 text-center flex flex-col justify-between border border-emerald-700">
          <div>
            <h3 class="text-2xl font-serif mb-6">Événements Privés</h3>
            <div class="text-2xl md:text-3xl font-serif mb-2">Sur Devis</div>
            <p class="text-emerald-100 mb-8 text-sm">Anniversaires, EVJF, Retraite, Team Building</p>
            <p class="text-neutral-200 text-sm leading-relaxed mb-8">
              Nous créons un programme entièrement sur mesure pour votre groupe et vos envies.
            </p>
          </div>
          
          <a href="/contact" class="inline-block bg-white text-emerald-900 px-6 py-3 rounded-xl font-bold hover:bg-emerald-50 transition-colors">
            Demander un devis
          </a>
        </div>
      </div>
    </div>

  </section>

  <Footer />
</Layout>
