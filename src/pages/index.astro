---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Hero from '../components/Hero.astro';
import Presentation from '../components/Presentation.astro';
import Services from '../components/Services.astro';
import Footer from '../components/Footer.astro';

import { getImage } from "astro:assets";
import heroImage from "../assets/hero-bg.png";
import presentationImage from "../assets/anne-marie.webp";

const optimizedHero = await getImage({ src: heroImage, format: 'webp', width: 1920 });
const optimizedPresentation = await getImage({ src: presentationImage, format: 'webp', width: 800 });
---

<Layout
	title="Sophrologue à Namur | Anne-Marie – Consciences"
	description="Sophrologue certifiée près de Namur, Anne-Marie vous reçoit à Profondeville pour mieux gérer le stress, retrouver le sommeil et renforcer la confiance."
>
	<Navbar client:load />
	
	<main>
		<Hero backgroundImage={optimizedHero.src} />
		<Presentation image={optimizedPresentation.src} />
		<Services />
	</main>
    
    <Footer />
</Layout>
