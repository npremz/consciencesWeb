---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import anneMarieImg from '../assets/anne_marie.jpg';

const pages = await getCollection('pages');
const events = await getCollection('events');

const today = new Date();
today.setHours(0, 0, 0, 0);

// Sort: Future events first (closest to today), then past events (most recent first)
const sortedEvents = events.sort((a, b) => {
  const dateA = new Date(a.data.date);
  const dateB = new Date(b.data.date);
  return dateB.getTime() - dateA.getTime();
});

const latestEvents = sortedEvents.slice(0, 3);

// Icon definitions
const icons = {
  leaf: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C10.9 14.36 12 14 14 12c1 2 1.15 3.06.08 6-.63 3.23-2.08 5-5.08 5-3 0-7-1-7-2Z"/></svg>`,
  users: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  world: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>`,
  phone: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  mail: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
  flower: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 16.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 1 1 12 7.5 4.5 4.5 0 1 1 16.5 12 4.5 4.5 0 1 1 12 16.5"/><path d="M12 7.5V2"/><path d="M12 22v-5.5"/><path d="m16.5 12 5.5.01"/><path d="M2 12h5.5"/><path d="m15.18 8.82 3.89-3.89"/><path d="m4.93 19.07 3.89-3.89"/><path d="m15.18 15.18 3.89 3.89"/><path d="m4.93 4.93 3.89 3.89"/></svg>`
};
---

<BaseLayout
	title="Sophrologue à Namur et Profondeville | Consciences.be"
	description="Anne-Marie Van Der Smissen, sophrologue certifiée près de Namur, vous accompagne à Profondeville pour mieux gérer stress, sommeil, émotions et transitions de vie."
>
	<!-- Hero Section -->
	<section class="relative pt-28 pb-16 md:pt-48 md:pb-32 px-6 overflow-hidden">
		<div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-10 md:gap-16 items-center">
			<div class="lg:col-span-8 relative z-10">
				<div>
					<span class="text-[#8A9A5B] font-bold text-[10px] md:text-sm uppercase tracking-[0.2em] md:tracking-[0.3em] mb-4 md:mb-6 block">Anne-Marie • Sophrologue certifiée près de Namur</span>
				</div>
				<h1 class="text-3xl sm:text-5xl md:text-8xl font-bold font-['Cormorant_Garamond'] leading-[1.1] mb-6 md:mb-10">
					Cultiver l'équilibre en toute <span class="italic font-medium text-[#8A9A5B]">conscience</span>
				</h1>
				<p class="text-xl md:text-2xl text-[#2A362E]/80 max-w-2xl mb-8 md:mb-12 leading-relaxed font-['Lora']">
					À Profondeville, dans la région de Namur, je vous accompagne pour gérer le stress, améliorer le sommeil et traverser les étapes de vie avec douceur et positivité.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 md:gap-8">
					<a href="/sophrologie" class="px-8 md:px-12 py-4 md:py-5 bg-[#4A5D4E] text-white text-xs md:text-sm font-bold uppercase tracking-widest text-center hover:bg-[#8A9A5B] transition-all shadow-xl shadow-[#4A5D4E]/20">
						Découvrir la Sophrologie
					</a>
					<a href="/#propos" class="px-8 md:px-12 py-4 md:py-5 border border-[#4A5D4E]/30 text-[#4A5D4E] text-xs md:text-sm font-bold uppercase tracking-widest text-center hover:border-[#4A5D4E] transition-all">
						Ma Philosophie
					</a>
				</div>
			</div>
			
			<div class="lg:col-span-4 relative lg:block">
				<div class="aspect-[4/5] sm:aspect-[3/4] relative overflow-hidden rounded-[2rem] md:rounded-[4rem] shadow-2xl rotate-2 max-w-sm mx-auto lg:max-w-none">
          <Image src={anneMarieImg} alt="Anne-Marie, Sophrologue" class="object-cover w-full h-full" />
					<div class="absolute inset-0 bg-gradient-to-tr from-[#8A9A5B]/20 to-transparent pointer-events-none"></div>
				</div>
			</div>
		</div>
	</section>

	<!-- Philosophie -->
	<section id="propos" class="py-20 md:py-32 px-6 bg-[#FAF9F6] relative">
		<div class="max-w-7xl mx-auto">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 md:gap-20 items-center">
				<div class="lg:col-span-5">
					<h2 class="text-4xl md:text-6xl font-bold mb-6 md:mb-8 italic leading-tight">Conscience...<br/><span class="text-[#8A9A5B]">Consciences...</span></h2>
					<p class="text-lg md:text-xl leading-relaxed mb-8">
						Grâce à une approche centrée sur l'écoute et le corps, nous explorons ensemble trois dimensions essentielles de votre existence.
					</p>
					<div class="w-16 h-1 bg-[#DCAE96] mb-12"></div>
				</div>
				<div class="lg:col-span-7 grid grid-cols-1 gap-10 md:gap-12">
					{[
						{ t: "Conscience de Soi", d: "Explorer son potentiel et son avenir en ce qu'il a de plus lumineux.", i: icons.leaf },
						{ t: "Conscience des Autres", d: "Comprendre les liens qui nous unissent et nos influences réciproques.", i: icons.users },
						{ t: "Conscience du Monde", d: "Se reconnecter à son environnement pour une interaction sereine.", i: icons.world }
					].map(item => (
						<div class="flex flex-col sm:flex-row gap-4 sm:gap-8 items-start group">
							<div class="w-10 h-10 md:w-12 md:h-12 text-[#8A9A5B] flex-shrink-0 transition-transform duration-500 group-hover:scale-110">
								<Fragment set:html={item.i.replace('width="24"', 'width="100%"').replace('height="24"', 'height="100%"')} />
							</div>
							<div>
								<h3 class="text-xl md:text-2xl font-bold mb-2 text-[#4A5D4E]">{item.t}</h3>
								<p class="text-base md:text-lg text-[#2A362E]/70 font-['Lora']">{item.d}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- Services -->
	<section class="py-20 md:py-32 px-6 bg-white relative overflow-hidden">
		<div class="max-w-7xl mx-auto relative z-10">
			<div class="text-center mb-16 md:mb-24">
				<span class="text-[#8A9A5B] font-bold text-sm uppercase tracking-[0.4em] mb-4 block">Services</span>
				<h2 class="text-4xl md:text-7xl font-bold italic">Nos Accompagnements</h2>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-10">
				{pages.sort((a, b) => a.data.title.localeCompare(b.data.title)).map(page => (
					<a href={`/${page.id}`} class="group p-8 md:p-12 bg-[#FAF9F6] hover:bg-white border border-[#4A5D4E]/5 hover:shadow-2xl transition-all duration-700 rounded-[2rem] md:rounded-3xl relative overflow-hidden">
						<div class="absolute top-0 left-0 w-full h-1 bg-[#8A9A5B] scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-700"></div>
						<h3 class="text-2xl md:text-3xl font-bold mb-4 md:mb-6 text-[#4A5D4E] group-hover:italic transition-all">{page.data.title}</h3>
						<p class="text-base md:text-lg text-[#2A362E]/60 mb-8 md:mb-10 line-clamp-3 font-['Lora'] leading-relaxed">{page.data.description}</p>
						<span class="text-xs font-bold uppercase tracking-widest text-[#8A9A5B] flex items-center gap-4">
							Explorer <span class="transform group-hover:translate-x-2 transition-transform duration-500">⟶</span>
						</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Agenda -->
	<section class="py-12 md:py-32 px-6 bg-[#F4F2EE]">
		<div class="max-w-5xl mx-auto">
			<h2 class="text-4xl md:text-5xl font-bold italic text-center mb-10 md:mb-20">Prochains Ateliers</h2>
			<div class="space-y-4 md:space-y-8">
				{latestEvents.map(item => {
          const eventDate = new Date(item.data.date);
          const isPast = eventDate < today;
          return (
            <div class={`bg-white p-5 md:p-10 rounded-[1.5rem] md:rounded-[2rem] shadow-sm hover:shadow-xl transition-all duration-500 flex flex-col md:flex-row justify-between items-center gap-5 md:gap-10 border border-white hover:border-[#8A9A5B]/20 ${isPast ? 'opacity-70' : ''}`}>
              <div class="text-center md:text-left">
                <div class="flex flex-wrap items-center gap-2 mb-2 md:mb-4 justify-center md:justify-start">
                  <span class="px-3 py-1 bg-[#8A9A5B]/10 text-[#8A9A5B] text-[10px] md:text-xs font-bold uppercase tracking-widest rounded-full inline-block">{item.data.dateLabel}</span>
                  {isPast && <span class="px-3 py-1 bg-gray-100 text-gray-500 text-[10px] md:text-xs font-bold uppercase tracking-widest rounded-full inline-block">Événement passé</span>}
                </div>
                <h3 class="text-xl md:text-3xl font-bold text-[#4A5D4E] mb-1 md:mb-2">{item.data.title}</h3>
                <p class="text-sm md:text-lg italic text-[#2A362E]/50">📍 {item.data.location}</p>
              </div>
              <div class="flex flex-col sm:flex-row items-center gap-4 md:gap-10 w-full md:w-auto">
                <span class="text-xl md:text-3xl font-['Cormorant_Garamond'] font-bold text-[#4A5D4E]">{item.data.price}</span>
                <a href={`/evenements/${item.id}`} class="w-full md:w-auto px-6 py-3 md:px-10 md:py-4 bg-[#4A5D4E] text-white font-bold uppercase tracking-widest text-[10px] md:text-xs text-center hover:bg-[#8A9A5B] transition-all shadow-lg">Programme</a>
              </div>
            </div>
          );
        })}
			</div>
		</div>
	</section>

	<!-- Contact & Formulaire -->
	<section id="contact" class="bg-[#2A362E] py-20 md:py-32 px-6 text-white relative overflow-hidden">
		<div class="absolute top-0 right-0 w-1/2 h-full bg-white opacity-[0.02] -skew-x-12 translate-x-1/2"></div>
		
		<div class="max-w-7xl mx-auto relative z-10">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 md:gap-20">
				
				<!-- Infos de contact -->
				<div class="lg:col-span-5">
					<h2 class="text-4xl md:text-6xl font-bold italic mb-8 md:mb-12">Me Contacter</h2>
					<p class="text-lg md:text-xl text-white/70 font-['Lora'] mb-10 md:mb-16 leading-relaxed">
						"Faisons en sorte que vos rêves deviennent réalité. Je vous répondrai avec plaisir pour toute question ou prise de rendez-vous."
					</p>
					
					<div class="space-y-6 md:space-y-10">
						<a href="tel:+32474294983" class="flex items-center gap-4 md:gap-6 group">
							<div class="w-12 h-12 md:w-14 md:h-14 rounded-full border border-white/20 flex items-center justify-center text-[#8A9A5B] group-hover:bg-[#8A9A5B] group-hover:text-white transition-all duration-500">
								<Fragment set:html={icons.phone} />
							</div>
							<div>
								<p class="text-[8px] md:text-[10px] uppercase tracking-widest text-white/40 font-bold mb-1">Téléphone</p>
								<p class="text-xl md:text-2xl font-bold">+32 474 29 49 83</p>
							</div>
						</a>
						
						<a href="mailto:consciences@yahoo.com" class="flex items-center gap-4 md:gap-6 group">
							<div class="w-12 h-12 md:w-14 md:h-14 rounded-full border border-white/20 flex items-center justify-center text-[#8A9A5B] group-hover:bg-[#8A9A5B] group-hover:text-white transition-all duration-500">
								<Fragment set:html={icons.mail} />
							</div>
							<div>
								<p class="text-[8px] md:text-[10px] uppercase tracking-widest text-white/40 font-bold mb-1">Email</p>
								<p class="text-xl md:text-2xl font-bold break-all">consciences@yahoo.com</p>
							</div>
						</a>
					</div>
					
					<p class="mt-12 md:mt-20 text-white/40 text-xs md:text-sm uppercase tracking-widest italic">
						📍 Uniquement sur rendez-vous à Profondeville
					</p>
				</div>

				<!-- Formulaire -->
				<div class="lg:col-span-7">
					<form class="bg-white p-8 md:p-16 rounded-[2rem] md:rounded-[3rem] shadow-2xl text-[#2A362E]">
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 mb-6 md:mb-8">
							<div class="space-y-2">
								<label for="name" class="text-[10px] md:text-sm font-bold uppercase tracking-widest text-[#4A5D4E]/60">Nom complet</label>
								<input type="text" id="name" name="name" placeholder="Ex: Jean Dupont" class="w-full bg-[#FAF9F6] border border-[#4A5D4E]/10 px-4 md:px-6 py-3 md:py-4 rounded-xl focus:outline-none focus:border-[#8A9A5B] transition-colors font-['Lora']" />
							</div>
							<div class="space-y-2">
								<label for="email" class="text-[10px] md:text-sm font-bold uppercase tracking-widest text-[#4A5D4E]/60">Votre Email</label>
								<input type="email" id="email" name="email" placeholder="jean@exemple.com" class="w-full bg-[#FAF9F6] border border-[#4A5D4E]/10 px-4 md:px-6 py-3 md:py-4 rounded-xl focus:outline-none focus:border-[#8A9A5B] transition-colors font-['Lora']" />
							</div>
						</div>
						
						<div class="space-y-2 mb-6 md:mb-8">
							<label for="subject" class="text-[10px] md:text-sm font-bold uppercase tracking-widest text-[#4A5D4E]/60">Sujet de votre demande</label>
							<select id="subject" name="subject" class="w-full bg-[#FAF9F6] border border-[#4A5D4E]/10 px-4 md:px-6 py-3 md:py-4 rounded-xl focus:outline-none focus:border-[#8A9A5B] transition-colors font-['Lora'] appearance-none">
								<option>Prise de rendez-vous (Sophrologie / PNL)</option>
								<option>Inscription à un atelier / Balade</option>
								<option>Demande d'informations</option>
								<option>Événement spécial / Journée Mieux-Être</option>
							</select>
						</div>

						<div class="space-y-2 mb-8 md:mb-10">
							<label for="message" class="text-[10px] md:text-sm font-bold uppercase tracking-widest text-[#4A5D4E]/60">Votre Message</label>
							<textarea id="message" name="message" rows="5" placeholder="Comment puis-je vous aider ?" class="w-full bg-[#FAF9F6] border border-[#4A5D4E]/10 px-4 md:px-6 py-3 md:py-4 rounded-xl focus:outline-none focus:border-[#8A9A5B] transition-colors font-['Lora'] resize-none"></textarea>
						</div>

						<button type="submit" class="w-full bg-[#4A5D4E] text-white py-4 md:py-5 rounded-xl font-bold uppercase tracking-[0.2em] text-[10px] md:text-sm hover:bg-[#8A9A5B] transition-all duration-500 shadow-xl shadow-[#4A5D4E]/10">
							Envoyer ma demande
						</button>
					</form>
				</div>

			</div>
		</div>
	</section>
</BaseLayout>
