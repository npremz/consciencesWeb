---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import { Check, Clock, Euro, Users, Heart, Sparkles } from 'lucide-react';

import { getImage } from "astro:assets";
import headerImage from "../assets/hero-bg.png";

const optimizedHeader = await getImage({ src: headerImage, format: 'webp', width: 1920 });

const benefits = [
  "Gestion du stress et des émotions",
  "Amélioration du sommeil",
  "Confiance en soi",
  "Préparation aux examens",
  "Gestion des phobies",
  "Accompagnement de vie"
];
---

<Layout
  title="Sophrologie à Namur et Profondeville | Consciences"
  description="Séances de sophrologie à Profondeville, près de Namur : stress, sommeil, émotions et confiance en soi. Découvrez l'accompagnement d'Anne-Marie."
  serviceType="Séances de sophrologie à Namur et Profondeville"
>
  <Navbar client:load />
  
  <PageHeader 
    title="Sophrologie à Namur"
    subtitle="Des séances individuelles à Profondeville pour retrouver calme, équilibre et confiance."
    image={optimizedHeader.src}
  />

  <section class="py-20 3xl:py-40 max-w-[1000px] mx-auto px-6">
    
    {/* Intro Definition */}
    <div class="mb-20 text-center">
      <h2 class="text-3xl font-serif text-emerald-900 mb-6">Qu'est-ce que la sophrologie ?</h2>
      <p class="text-lg text-neutral-600 leading-relaxed mb-5">
        Une série d'outils imaginés qui vise à mieux nous connaître pour pouvoir agir sur notre corps, 
        notre esprit et nos émotions. Ainsi, nous améliorons notre bien-être et notre santé, 
        ce qui va nous apporter un équilibre nous rapprochant du bonheur.
      </p>
      <p class="text-lg text-neutral-600 leading-relaxed">
        Sophrologue certifiée dans la région de Namur, je vous accueille à Profondeville dans un cadre
        bienveillant. Les séances associent respiration, détente musculaire et visualisation positive.
        L'accompagnement est adapté à votre situation, à votre rythme et à l'objectif défini ensemble.
      </p>
    </div>

    {/* Local practice */}
    <div class="mb-20 bg-neutral-50 border border-neutral-100 rounded-2xl p-6 md:p-10">
      <div class="grid md:grid-cols-2 gap-10">
        <div>
          <h2 class="text-3xl font-serif text-emerald-900 mb-5">Votre séance près de Namur</h2>
          <p class="text-neutral-600 leading-relaxed mb-4">
            Le cabinet se situe à Profondeville, dans la province de Namur. Il accueille les adultes,
            adolescents et enfants qui souhaitent disposer d'outils concrets à réutiliser au quotidien.
          </p>
          <p class="text-neutral-600 leading-relaxed">
            Un premier échange permet de comprendre votre besoin. Chaque séance comprend ensuite un
            temps d'écoute, une pratique guidée et un retour sur les sensations vécues.
          </p>
        </div>
        <div>
          <h2 class="text-3xl font-serif text-emerald-900 mb-5">Pourquoi consulter ?</h2>
          <ul class="space-y-3 text-neutral-700">
            <li class="flex items-start gap-3"><Check size={18} className="text-emerald-500 shrink-0 mt-1" />Apaiser le stress et mieux vivre ses émotions</li>
            <li class="flex items-start gap-3"><Check size={18} className="text-emerald-500 shrink-0 mt-1" />Préparer un examen ou une étape importante</li>
            <li class="flex items-start gap-3"><Check size={18} className="text-emerald-500 shrink-0 mt-1" />Retrouver un sommeil plus serein</li>
            <li class="flex items-start gap-3"><Check size={18} className="text-emerald-500 shrink-0 mt-1" />Développer la confiance et la connaissance de soi</li>
          </ul>
        </div>
      </div>
    </div>

    {/* 3 Pillars Grid */}
    <div class="grid md:grid-cols-3 gap-8 mb-20">
      <div class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-neutral-100 text-center">
        <div class="w-12 h-12 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4 text-emerald-700 font-bold">1</div>
        <h3 class="font-serif text-xl mb-3 text-emerald-900">Action Positive</h3>
        <p class="text-sm text-neutral-500">Tout ce que nous proposons est basé sur le positif rationnel.</p>
      </div>
      <div class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-neutral-100 text-center">
        <div class="w-12 h-12 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4 text-emerald-700 font-bold">2</div>
        <h3 class="font-serif text-xl mb-3 text-emerald-900">Schéma Corporel</h3>
        <p class="text-sm text-neutral-500">Avoir conscience de son corps et de son fonctionnement comme réalité vécue.</p>
      </div>
      <div class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-neutral-100 text-center">
        <div class="w-12 h-12 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4 text-emerald-700 font-bold">3</div>
        <h3 class="font-serif text-xl mb-3 text-emerald-900">Réalité Objective</h3>
        <p class="text-sm text-neutral-500">L'objectif poursuivi est celui de la personne qui consulte.</p>
      </div>
    </div>

    {/* Benefits & Audience */}
    <div class="flex flex-col md:flex-row gap-12 items-start mb-20">
      <div class="flex-1">
        <h3 class="text-2xl font-serif text-emerald-900 mb-6">En quoi puis-je vous aider ?</h3>
        <ul class="space-y-3">
          {benefits.map((item) => (
            <li class="flex items-center gap-3 text-neutral-700">
              <Check size={18} className="text-emerald-500 shrink-0" />
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="flex-1 bg-emerald-50 p-6 md:p-8 rounded-2xl">
        <h3 class="text-2xl font-serif text-emerald-900 mb-4">Pour qui ?</h3>
        <p class="text-neutral-700 mb-4">
          <strong>Tout le monde !</strong> Adultes, enfants, adolescents.
        </p>
        <p class="text-neutral-600 text-sm">
          Nous avons tous besoin d'un peu de douceur dans notre vie, de temps pour soi, 
          que cela soit pour se sentir mieux, pour régler un problème, ou de manière préventive.
        </p>
      </div>
    </div>

    {/* Pricing Sections */}
    <div id="yoga-nidra" class="scroll-mt-24 space-y-12">
      <h2 class="text-3xl font-serif text-center text-emerald-900 mb-12">Tarifs & Inscriptions</h2>
      
      <div class="grid md:grid-cols-2 gap-8 mb-12">
        {/* Individual */}
        <div class="bg-emerald-900 text-white rounded-2xl p-8 md:p-10 text-center flex flex-col justify-between">
          <div>
            <div class="flex justify-center mb-6">
               <Users size={32} className="text-emerald-400" />
            </div>
            <h3 class="text-2xl font-serif mb-6">Séance Individuelle</h3>
            <div class="text-4xl md:text-5xl font-serif mb-2">60€</div>
            <p class="text-emerald-200 mb-8 text-sm">Premier entretien inclus + Relaxation personnalisée</p>
          </div>
          
          <div class="inline-block bg-white/10 backdrop-blur-sm px-6 py-3 rounded-lg border border-white/20">
            <p class="font-medium flex items-center gap-2 justify-center text-sm">
              <Sparkles size={16} className="shrink-0" />
              Carte 5 séances : 250€
            </p>
          </div>
        </div>

        {/* Collective */}
        <div class="bg-emerald-800 text-white rounded-2xl p-8 md:p-10 text-center flex flex-col justify-between">
          <div>
            <div class="flex justify-center mb-6">
               <Heart size={32} className="text-emerald-300" />
            </div>
            <h3 class="text-2xl font-serif mb-6">Atelier Collectif</h3>
            <div class="text-4xl md:text-5xl font-serif mb-2">15€</div>
            <p class="text-emerald-100 mb-8 text-sm">Thématique généraliste, partage de groupe</p>
          </div>
          
          <div class="inline-block bg-white/10 backdrop-blur-sm px-6 py-3 rounded-lg border border-white/20">
            <p class="font-medium flex items-center gap-2 justify-center text-sm">
              <Sparkles size={16} className="shrink-0" />
              Carte 10 séances : 100€
            </p>
          </div>
        </div>
      </div>

      <div class="flex justify-center">
        <a href="/contact/" class="group bg-emerald-600 hover:bg-emerald-700 text-white px-10 py-4 rounded-xl font-bold text-lg transition-all shadow-xl shadow-emerald-900/10 flex items-center gap-3">
          Prendre rendez-vous
          <Sparkles size={20} className="group-hover:animate-pulse shrink-0" />
        </a>
      </div>
    </div>

  </section>

  <Footer />
</Layout>
